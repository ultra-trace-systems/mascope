    family-names: Shenhav
    affiliation: Ultra Trace Systems Oy
  - given-names: Alexei
    family-names: Upornikov
    affiliation: Ultra Trace Systems Oy
repository-code: "https://github.com/ultra-trace-systems/mascope"
url: "https://github.com/ultra-trace-systems/mascope"
license: Apache-2.0
version: 1.7.2
date-released: "2026-08-19"
# Bumped per release (in the same prep commit as the CHANGELOG): `version` +
# `date-released` identify the release being cut. `doi` is the concept DOI -
# it always resolves to the latest archived release and is what the README
# badge links to. The per-version DOI exists only after Zenodo archives the
# published release, so it is not tracked here; pick it off the Zenodo
# record's version list when citing one exact release.
doi: "10.5281/zenodo.21037634"
# The paper to cite in preference to the software itself. GitHub's "Cite this
# repository" widget surfaces this, and reference managers prefer it over the
# top-level software metadata.
preferred-citation:
  type: article
  title: >-
    Networked Open-Source Infrastructure for Scalable Analysis of Chemical
    Ionization Mass Spectrometry Data
