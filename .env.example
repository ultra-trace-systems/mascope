# Example environment for a self-hosted deployment (docker-compose.yaml).
# Copy to `.env` and adjust if needed; every value has a sane default, so an
# empty/absent .env also works. (To just try Mascope, use docker-compose.demo.yaml.)

# Image version to pull. Pin a release for production (e.g. v1.0.0), or use
# `latest` to track the newest build. (Usually set by checking out the matching
# git tag/commit, since the CLI derives this from git when unset.)
MASCOPE_VERSION=latest

# Host port to serve the web UI on (http://localhost:<port>).
MASCOPE_HTTP_PORT=8080

# Runtime env name (keeps all state under .runtime/env/<name>). Set it HERE for
# raw `docker compose` -- `mascope env use` only affects the `mascope` CLI.
MASCOPE_ENV=default

# Where stored sample files live on the host (bind-mounted into the backend).
MASCOPE_FILESTORE=./.runtime/env/default/filestore

# Log level: trace | debug | info | success | warning | error | critical
MASCOPE_LOGLEVEL=info

# Database user (the database name is derived as mascope_<MASCOPE_ENV>).
MASCOPE_DB_USER=mascope_user

# ---------------------------------------------------------------------------
# Secrets are NOT set here -- they are files under .runtime/secrets/ (mounted as
# docker secrets). Create them once before the first `up`:
#
#   mkdir -p .runtime/secrets
#   head -c 32 /dev/urandom | xxd -p -c 32 > .runtime/secrets/postgres_password.txt
#   head -c 32 /dev/urandom | xxd -p -c 32 > .runtime/secrets/jwt_secret_key.txt
#   head -c 32 /dev/urandom | xxd -p -c 32 > .runtime/secrets/server_owner_secret_key.txt
# ---------------------------------------------------------------------------
