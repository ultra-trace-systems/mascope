[Unit]
Description=Mascope Application
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=@@USER@@
# The deployment checkout. systemd would otherwise start the unit in "/", and
# CLI behaviour that reads the checkout (notably which release tag is checked
# out) has no repository to read.
WorkingDirectory=@@MASCOPE_PATH@@
EnvironmentFile=/etc/environment
ExecStart=@@MASCOPE_BIN@@ prod up --detach
ExecStop=@@MASCOPE_BIN@@ prod down
TimeoutStartSec=300
# Longer than the longest chain of stop grace periods `prod down` can wait
# through. `docker compose down` stops each service only once everything that
# depends on it has stopped, giving each its stop_grace_period from
# docker-compose.yaml: the file converter's 90 s, then the backend's 90 s, then
# Redis and Postgres. At systemd's 90 s default `prod down` would be killed
# part-way and the rest of the stack never stopped by it.
# tooling/cli/tests/test_systemd_units.py holds the two together.
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target