# Mascope peak-assignment retention configuration.
#
# tooling/ubuntu.sh installs this to /etc/mascope/prune.env (chmod 600) and
# mascope-assignment-prune.service reads it. The timer is enabled by default
# and runs fine with everything here left commented out - these are overrides,
# not required settings. See docs/maintaining.md -> "Reclaiming assignment
# runs" for the full picture.

# Newest completed assignment runs kept per sample AND engine, so runs imported
# from an external engine and runs computed in-app age out of separate quotas
# and neither can evict the other. More than one so a re-run can still be
# compared against the result it replaced. This bounds re-runs only: a
# sample's ingest run is never superseded, so the pass reclaims nothing on a
# deployment that only assigns at ingest.
# MASCOPE_PRUNE_KEEP_PER_SAMPLE=2

# Newest completed assignment runs kept per sample across ALL engines. The
# per-engine quota above cannot bound the table on its own, because the engine
# name is supplied by the importing client: one that varies per build would
# mint a fresh quota on every import. The in-app engine is exempt from this
# total, so it can never evict the history the per-engine quota protects.
# Must be at least MASCOPE_PRUNE_KEEP_PER_SAMPLE.
# MASCOPE_PRUNE_KEEP_PER_SAMPLE_TOTAL=12

# Hours a failed (or otherwise terminal, non-completed) run stays inspectable
# before its rows are reclaimed.
# MASCOPE_PRUNE_KEEP_FAILED_HOURS=24

# Hours before an in-flight ('pending'/'running') run is presumed dead and
# reclaimed. Floored at 12 in the script - a shorter grace could delete a run
# that is still executing.
# MASCOPE_PRUNE_KEEP_RUNNING_HOURS=72

# Hours before an unfinished import ('importing') is presumed abandoned and
# reclaimed with its staged rows. Such a run blocks new assignment work on its
# sample, so this is shorter than the in-flight grace; it is floored at 1, which
# is longer than any upload should take. A client that knows the run id can also
# delete it outright rather than waiting for this.
# MASCOPE_PRUNE_KEEP_IMPORTING_HOURS=24
