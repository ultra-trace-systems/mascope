{
  "name": "mascope",
  "author": {
    "name": "www.ultratrace.eu",
    "email": "support@ultratrace.eu"
  },
  "description": "Ultra Trace Mascope",
  "homepage": "https://www.ultratrace.eu",
  "version": "2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "vite --open",
    "docs": "cd ../.. && uv run --only-group docs mkdocs serve",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test --project=e2e",
    "test:e2e:full": "npx playwright test --project=e2e --project=e2e-firefox --project=e2e-webkit",
    "test:only": "npx playwright test --project=e2e --retries=0 -g",
    "test:headed": "npx playwright test --project=e2e --headed --trace off --timeout 0 --reporter list --retries=0 -g",
    "test:trace": "npx playwright test --project=e2e --trace on --retries=0 -g",
    "test:gen": "npx playwright codegen http://localhost:8080/",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write src/",
    "palette": "node scripts/palette.js",
    "clean": "npm run clean:windows && npm run clean:linux",
    "clean:windows": "node -e \"if (process.platform === 'win32') process.exit(1)\" || , if exist node_modules rmdir /Q /S node_modules",
    "clean:linux": "node -e \"if (process.platform !== 'win32') process.exit(1)\" || rm -rf node_modules"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.1.9",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "@primevue/themes": "^4.5.4",
    "@uppy/core": "^5.2.0",
    "@uppy/dashboard": "^5.1.1",
    "@uppy/drop-target": "^4.1.0",
    "@uppy/tus": "^5.1.1",
    "@uppy/vue": "^3.2.0",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "chart.js": "^4.5.1",
    "pinia": "^4.0.2",
    "plotly.js-dist-min": "^3.7.0",
    "primeicons": "^8.0.0",
    "primevue": "^4.5.4",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@rushstack/eslint-patch": "^1.16.1",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.11",
    "chroma-js": "^3.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.1",
    "prettier": "^3.9.6",
    "vite": "^8.2.0",
    "vitest": "^4.1.9"
  },
  "overrides": {}
}
