{
  "about": [
    "The known answers of the hermetic MS2 fixture (server/backend/tests/ms2_fixture.py).",
    "Each shape is the committed MS1 file read through a patched OpenTFRaw backend: its survey scans are the file's own, its fragment scans synthetic. Change the fixture here and nowhere else.",
    "Every shape is positive: no shape records the negative polarity or switches polarity, on purpose."
  ],
  "definitions": {
    "mz": "Exact monoisotopic m/z of the singly charged ion: the formula's mass less one electron.",
    "isolation_mz": "The precursor m/z the scan filter names, at four decimals, as the instrument writes it. The summary's parent_peak_mz.",
    "survival": "Precursor intensity over the precursor and its named fragments together; the co-isolate, the ghost and the unexplained centroid are not counted.",
    "loss": "The neutral formula between the precursor and a fragment.",
    "volts": "The trailer's HCD Energy V: of a step, nce times isolation_mz over 500 for a singly charged ion, at two decimals.",
    "co_isolate": "Another ion inside every isolation window the precursor is taken with; it is not a sub-formula of the precursor and does not fragment.",
    "harmonic_ghost": "The precursor's second harmonic: twice its frequency, so a quarter of its m/z, at ghost_ratio of its intensity, under the 0.5 % the design note's rule reads such a ghost by.",
    "e50": "Per precursor of a shape that steps its energy: linear interpolation at the first downward crossing of survival 0.5, on NCE and on the volts the trailer records (docs/dev/ms2_analysis.md, survival and E50).",
    "unexplained": "A centroid no sub-formula of the precursor or the co-isolate explains.",
    "centroid_labels": "Every fragment scan of a step carries its spectrum's centroids exactly, with noise as the noise of each and resolution its scan's FT resolution times sqrt(200 / mz), rounded.",
    "times": "Scan n is acquired at n times scan_interval_min minutes."
  },
  "noise": 1.0,
  "ghost_ratio": 0.004,
  "scan_interval_min": 0.02,
